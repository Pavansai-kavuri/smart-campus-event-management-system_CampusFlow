{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist-server",
    "rootDir": "./server/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["server/src/**/*"],
  "exclude": [
    "server/src/__tests__",
    "server/src/__tests__/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
